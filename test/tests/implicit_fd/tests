      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL iterations'
      absent_out = 'iterations ([0-9]{3,}|[2-9][0-9]|1[3-9])\b'
      compute_devices = 'cpu'
      detail = 'on a 128 x 128 grid, and'
    []
    [n256]
      type = RunApp
      input = bc_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC n=256 Outputs/csv=false -u_ksp_converged_reason'
      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL iterations'
      absent_out = 'iterations ([0-9]{3,}|[2-9][0-9]|1[3-9])\b'
      compute_devices = 'cpu'
      detail = 'on a 256 x 256 grid.'
    []
  []

  [jacobi_diagonal_bcs]
    requirement = 'The system shall converge a Jacobi-preconditioned conjugate gradient solve with boundary faces in the iteration count that the diagonal including the boundary face terms gives'
    # Jacobi-preconditioned CG takes 164 iterations; with the interior diagonal also in the
    # cells next to a face it takes 95, so the count tells the two apart
    type = RunApp
    input = bc_mms.i
    cli_args = 'TensorSolver/linear_solver=PETSC n=64 Outputs/csv=false -u_pc_type jacobi -u_ksp_converged_reason'
    expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL iterations 164\b'
    compute_devices = 'cpu'
  []

  [petsc_options]
    requirement = 'The system shall pass PETSc options to the implicit finite-difference solve under the prefix of the solved field'
    [default]
      type = RunApp
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/csv=false -u_ksp_view'
      expect_out = 'KSP Object: \(u_\).*type: cg.*PC Object: \(u_\).*type: mg'
      compute_devices = 'cpu'
      detail = 'with the conjugate gradient method and geometric multigrid by default,'
    []
    [block]
      type = RunApp
      input = be_mode.i
      cli_args = "TensorSolver/linear_solver=PETSC TensorSolver/petsc_options_iname='-pc_type' "
                 "TensorSolver/petsc_options_value='jacobi' Outputs/csv=false -u_ksp_view"
      expect_out = 'PC Object: \(u_\) [^\n]*\n\s+type: jacobi'
      compute_devices = 'cpu'
      detail = 'from the solver block,'
    []
    [command_line]
      type = RunApp
      input = be_mode.i
      cli_args = "TensorSolver/linear_solver=PETSC TensorSolver/petsc_options_iname='-pc_type' "
                 "TensorSolver/petsc_options_value='jacobi' Outputs/csv=false -u_pc_type none "
                 "-u_ksp_view"
      expect_out = 'PC Object: \(u_\) [^\n]*\n\s+type: none'
      compute_devices = 'cpu'
      detail = 'from the command line, overriding the solver block, and'
    []
    [last_step]
      type = RunApp
      input = be_mode.i
      # the default smoother takes 2 iterations
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/csv=false -u_mg_levels_ksp_max_it 3 -u_ksp_view'
      expect_out = 'Time Step 10,.*KSP Object: \(u_mg_levels_1_\).*maximum iterations=3'
      compute_devices = 'cpu'
      detail = 'for the multigrid levels, still applied in the last time step.'
    []
  []

  [smoother]
    requirement = 'The system shall smooth every multigrid level of the PETSc solve but the coarsest (LU) '
    [chebyshev]
      type = RunApp
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/csv=false -u_ksp_view'
      expect_out = 'KSP Object: \(u_mg_levels_1_\)[^\n]*\n\s+type: chebyshev.*PC Object: \(u_mg_levels_1_\)[^\n]*\n\s+type: sor.*KSP Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: chebyshev.*PC Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: jacobi'
      compute_devices = 'cpu'
      detail = 'by Chebyshev with SOR on the coarse levels and Jacobi on the fine level by default,'
    []
    [chebyshev_new_dt]
      type = RunApp
      input = biharmonic_mode.i
      # Jacobi on the levels, as on CUDA: Chebyshev bounds of the coarse levels kept from
      # dt = 1e-6 made the preconditioner indefinite at dt = 100
      cli_args = "TensorSolver/linear_solver=PETSC n=64 Outputs/csv=false Executioner/num_steps=2 "
                 "Executioner/TimeStepper/type=FunctionDT "
                 "Executioner/TimeStepper/function='if(t<1e-6,1e-6,100)' -u_mg_levels_pc_type jacobi "
                 "-u_ksp_converged_reason"
      expect_out = 'Time Step 2,.*Linear u_ solve converged due to CONVERGED_RTOL'
      compute_devices = 'cpu'
      detail = 'with the Chebyshev eigenvalue bounds of every level estimated again when the time step changes,'
    []
    [weight]
      type = RunApp
      input = biharmonic_mode.i
      # fine level: 1/dt = 100 and the 13-point stencil of Mkappa = 1e-3 at h = 1/32
      # give rho = 1 + 44 Mkappa / h^4 / (100 + 20 Mkappa / h^4), omega = 0.418031
      cli_args = 'TensorSolver/linear_solver=PETSC TensorSolver/smoother=DAMPED_JACOBI Outputs/csv=false -u_ksp_view'
      expect_out = 'KSP Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: richardson\n\s+damping factor=0.418031'
      compute_devices = 'cpu'
      detail = 'by damped Jacobi with the weight 4/(3 rho), rho the Gershgorin bound of the level operator, when requested,'
    []
    [user_weight]
      type = RunApp
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC TensorSolver/smoother=DAMPED_JACOBI Outputs/csv=false -u_mg_levels_ksp_richardson_scale 0.3 -u_ksp_view'
      expect_out = 'Time Step 10,.*KSP Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: richardson\n\s+damping factor=0.3\n'
      compute_devices = 'cpu'
      detail = 'with a damped Jacobi weight set on the command line instead, still applied in the last time step.'
    []
  []

  [divergence_test]
    requirement = 'The system shall not stop a converging PETSc solve of a large implicit time step on the divergence test'
    [biharmonic_large_dt]
      type = RunApp
      input = biharmonic_mode.i
      # warm started from u_old, ||r0|| / ||b|| = dt Mkappa lambda^2 ~ 6e3 at dt = 1000; the
      # first CG residual exceeded the default divtol of 1e4 times ||b||; it converges in 22
      cli_args = 'TensorSolver/linear_solver=PETSC TensorSolver/smoother=DAMPED_JACOBI n=128 dt=1000 Executioner/num_steps=1 Outputs/csv=false -u_ksp_converged_reason'
      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL'
      compute_devices = 'cpu'
    []
  []

  [bcs]
    requirement = 'The system shall solve implicit finite-difference problems on a non-periodic domain, with Dirichlet, Neumann and Robin conditions whose values vary along the face, from functions at the time of the unknown and from buffers as written at the start of the step, matching an independent sparse direct solve of the same discretisation, using the torch preconditioned conjugate gradient solver, for'
    # golds from an independent SciPy assembly of the same discretisation (spsolve); the
    # error is the O(h^2) discretisation error, observed orders 1.98-1.99 (3-point) and
    # 1.97-1.99 (5-point) from n = 32 to 128. With the boundary values at t instead of
    # t + dt, the backward Euler error is 0.044 rather than 0.0026.
    [poisson_3pt]
      type = CSVDiff
      input = bc_mms.i
      cli_args = 'Outputs/file_base=bc_poisson_3pt'
      csvdiff = bc_poisson_3pt.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'the steady Poisson problem with the 3-point stencil and a Robin face,'
    []
    [poisson_3pt_robin_buffer]
      type = CSVDiff
      input = bc_mms.i
      # the Robin c from a buffer, whose halo along the face is exchanged across ranks
      cli_args = 'TensorComputes/BCs/active="left right_buffer bottom top" Outputs/file_base=bc_poisson_3pt_robin_buffer'
      # same gold as poisson_3pt: the buffer holds right_c, and the problem is steady
      csvdiff = bc_poisson_3pt_robin_buffer.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'the same with the Robin value from a buffer,'
    []
    [poisson_5pt]
      type = CSVDiff
      input = bc_mms.i
      cli_args = 'stencil=5 rb=0 Outputs/file_base=bc_poisson_5pt'
      csvdiff = bc_poisson_5pt.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'the steady Poisson problem with the 5-point stencil,'
    []
    [be_3pt]
      type = CSVDiff
      input = bc_mms.i
      cli_args = 'tf=1 ops="dudt lap" num_steps=2 Outputs/file_base=bc_be_3pt'
      csvdiff = bc_be_3pt.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'backward Euler with time-dependent boundary values and the 3-point stencil,'
    []
    [be_5pt]
      type = CSVDiff
      input = bc_mms.i
      cli_args = 'tf=1 ops="dudt lap" num_steps=2 stencil=5 rb=0 Outputs/file_base=bc_be_5pt'
      csvdiff = bc_be_5pt.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'backward Euler with time-dependent boundary values and the 5-point stencil,'
    []
    [be_3pt_buffer]
      type = CSVDiff
      input = bc_mms.i
      # the top flux x - 2t from a buffer, which holds its value at t: the gold is the SciPy
      # solve with that flux at t, an O(dt) time error (0.0225 against 0.0026 from a function)
      cli_args = 'tf=1 ops="dudt lap" num_steps=2 TensorComputes/BCs/active="left right bottom top_buffer" Outputs/file_base=bc_be_3pt_buffer'
      csvdiff = bc_be_3pt_buffer.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'backward Euler with a time-dependent boundary value from a buffer, and'
    []
    [be_3pt_mps]
      type = CSVDiff
      input = bc_mms.i
      # single precision: the solve stops at l_tol = 1e-5, which leaves a solve error of
      # ~1e-5 |u| on top of the 2.6e-3 discretisation error
      cli_args = 'tf=1 ops="dudt lap" num_steps=2 TensorSolver/l_tol=1e-5 Outputs/file_base=bc_be_3pt'
      csvdiff = bc_be_3pt.csv
      rel_err = 1e-2
      compute_devices = 'mps'
      detail = 'backward Euler with the 3-point stencil in single precision on MPS.'
    []
  []

  [crank]
    requirement = 'The system shall reproduce analytic diffusion solutions from Crank, "The Mathematics of Diffusion" (2nd ed.), with implicit backward Euler finite differences and Dirichlet faces, matching an independent dense solve of the same discretisation, for'
    # golds from a dense SciPy backward Euler solve (the cell-centred 3-point
    # Laplacian with ghost 2c - u0). The error against the analytic solution is first order in
    # the substep down to the spatial floor of the semi-discrete solution, 3.2e-4: 5.8e-3, 1.7e-3,
    # 6.7e-4 at 25, 100, 400 substeps. The explicit real_space tests of the same problems give
    # 2.3e-4 with 250 forward Euler substeps.
    [semi_infinite]
      type = CSVDiff
      input = crank_semi_infinite.i
      csvdiff = crank_semi_infinite_out.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'a semi-infinite medium with a constant surface concentration (Sec. 3.3(i), eq. 3.13), and'
    []
    [thin_slab]
      type = CSVDiff
      input = crank_thin_slab.i
      csvdiff = crank_thin_slab_out.csv
      rel_err = 1e-6
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'an instantaneous planar source in a thin slab diffusing into an infinite medium (Sec. 2.5, eq. 2.15).'
    []
  []

