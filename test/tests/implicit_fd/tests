[Tests]
  design = 'ImplicitFDSolver.md TimeDerivativeOperator.md FiniteDifferenceBiharmonic.md'
  issues = '#184'

  [backward_euler]
    requirement = 'The system shall integrate a periodic Fourier mode with implicit backward Euler finite differences, reproducing the exact discrete amplification factor in every step, including after a time step change, using the torch preconditioned conjugate gradient solver'
    [2d_3pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 2D with the 3-point stencil,'
    []
    [2d_5pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 stencil=5 Outputs/file_base=be_mode_2d_5pt'
      csvdiff = be_mode_2d_5pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 2D with the 5-point stencil,'
    []
    [3d_3pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 Outputs/file_base=be_mode_3d_3pt'
      csvdiff = be_mode_3d_3pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 3D with the 3-point stencil,'
    []
    [3d_5pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 stencil=5 Outputs/file_base=be_mode_3d_5pt'
      csvdiff = be_mode_3d_5pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 3D with the 5-point stencil, and'
    []
    [2d_3pt_mps]
      type = CSVDiff
      input = be_mode.i
      # MPS has no double precision: a single precision reachable tolerance
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorSolver/l_tol=1e-5 dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      abs_zero = 1e-5
      rel_err = 1e-5
      compute_devices = 'mps'
      detail = 'in 2D with the 3-point stencil in single precision on MPS.'
    []
  []

  [backward_euler_petsc]
    requirement = 'The system shall integrate a periodic Fourier mode with implicit backward Euler finite differences, reproducing the exact discrete amplification factor in every step, including after a time step change, using the PETSc conjugate gradient solver with geometric multigrid'
    [2d_3pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      # max_error is the solve error, which PETSc and the torch gold leave at different
      # levels below l_tol * max(u) = 1e-8 * 0.71
      abs_zero = 1e-8
      prereq = 'backward_euler/2d_3pt'
      compute_devices = 'cpu'
      detail = 'in 2D with the 3-point stencil,'
    []
    [2d_5pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 stencil=5 Outputs/file_base=be_mode_2d_5pt'
      csvdiff = be_mode_2d_5pt.csv
      abs_zero = 1e-8
      prereq = 'backward_euler/2d_5pt'
      compute_devices = 'cpu'
      detail = 'in 2D with the 5-point stencil,'
    []
    [3d_3pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 Outputs/file_base=be_mode_3d_3pt'
      csvdiff = be_mode_3d_3pt.csv
      abs_zero = 1e-8
      prereq = 'backward_euler/3d_3pt'
      compute_devices = 'cpu'
      detail = 'in 3D with the 3-point stencil,'
    []
    [3d_5pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 stencil=5 Outputs/file_base=be_mode_3d_5pt'
      csvdiff = be_mode_3d_5pt.csv
      abs_zero = 1e-8
      prereq = 'backward_euler/3d_5pt'
      compute_devices = 'cpu'
      detail = 'in 3D with the 5-point stencil, and'
    []
    [2d_3pt_cuda]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      abs_zero = 1e-8
      compute_devices = 'cuda'
      min_slots = 2 # memory heavy
      capabilities = 'cuda'
      detail = 'in 2D with the 3-point stencil on CUDA.'
    []
  []

  [poisson]
    requirement = 'The system shall solve the singular steady periodic Poisson problem with implicit finite differences and return the zero-mean solution, using the torch preconditioned conjugate gradient solver'
    [3pt]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'with the second order 3-point stencil,'
    []
    [5pt]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorComputes/Solve/lap/stencil_width=5 Outputs/file_base=poisson_mms_5pt'
      csvdiff = poisson_mms_5pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'with the fourth order 5-point stencil, and'
    []
    [3pt_mps]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorSolver/l_tol=1e-5 Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      # single precision: the zero mean holds to round-off of the field magnitude
      abs_zero = 1e-5
      rel_err = 1e-4
      compute_devices = 'mps'
      detail = 'with the 3-point stencil in single precision on MPS.'
    []
  []

  [poisson_petsc]
    requirement = 'The system shall solve the singular steady periodic Poisson problem with implicit finite differences and return the zero-mean solution, using the PETSc conjugate gradient solver with geometric multigrid'
    [3pt]
      type = CSVDiff
