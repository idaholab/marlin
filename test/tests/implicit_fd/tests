[Tests]
  design = 'ImplicitFDSolver.md TimeDerivativeOperator.md FiniteDifferenceBiharmonic.md'
  issues = '#184'

  [backward_euler]
    requirement = 'The system shall integrate a periodic Fourier mode with implicit backward Euler finite differences, reproducing the exact discrete amplification factor in every step, including after a time step change, using the torch preconditioned conjugate gradient solver'
    [2d_3pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 2D with the 3-point stencil,'
    []
    [2d_5pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 stencil=5 Outputs/file_base=be_mode_2d_5pt'
      csvdiff = be_mode_2d_5pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 2D with the 5-point stencil,'
    []
    [3d_3pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 Outputs/file_base=be_mode_3d_3pt'
      csvdiff = be_mode_3d_3pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 3D with the 3-point stencil,'
    []
    [3d_5pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG dt2=0.02 stencil=5 Outputs/file_base=be_mode_3d_5pt'
      csvdiff = be_mode_3d_5pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 3D with the 5-point stencil, and'
    []
    [2d_3pt_mps]
      type = CSVDiff
      input = be_mode.i
      # MPS has no double precision: a single precision reachable tolerance
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorSolver/l_tol=1e-5 dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      abs_zero = 1e-5
      rel_err = 1e-5
      compute_devices = 'mps'
      detail = 'in 2D with the 3-point stencil in single precision on MPS.'
    []
  []

  [backward_euler_petsc]
    requirement = 'The system shall integrate a periodic Fourier mode with implicit backward Euler finite differences, reproducing the exact discrete amplification factor in every step, including after a time step change, using the PETSc conjugate gradient solver with geometric multigrid'
    [2d_3pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      # max_error is the solve error, which PETSc and the torch gold leave at different
      # levels below l_tol * max(u) = 1e-8 * 0.71
      abs_zero = 1e-8
      prereq = 'backward_euler/2d_3pt'
      compute_devices = 'cpu'
      detail = 'in 2D with the 3-point stencil,'
    []
    [2d_5pt]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 stencil=5 Outputs/file_base=be_mode_2d_5pt'
      csvdiff = be_mode_2d_5pt.csv
      abs_zero = 1e-8
      prereq = 'backward_euler/2d_5pt'
      compute_devices = 'cpu'
      detail = 'in 2D with the 5-point stencil,'
    []
    [3d_3pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 Outputs/file_base=be_mode_3d_3pt'
      csvdiff = be_mode_3d_3pt.csv
      abs_zero = 1e-8
      prereq = 'backward_euler/3d_3pt'
      compute_devices = 'cpu'
      detail = 'in 3D with the 3-point stencil,'
    []
    [3d_5pt]
      type = CSVDiff
      input = be_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 stencil=5 Outputs/file_base=be_mode_3d_5pt'
      csvdiff = be_mode_3d_5pt.csv
      abs_zero = 1e-8
      prereq = 'backward_euler/3d_5pt'
      compute_devices = 'cpu'
      detail = 'in 3D with the 5-point stencil, and'
    []
    [2d_3pt_cuda]
      type = CSVDiff
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC dt2=0.02 Outputs/file_base=be_mode_2d_3pt'
      csvdiff = be_mode_2d_3pt.csv
      abs_zero = 1e-8
      compute_devices = 'cuda'
      min_slots = 2 # memory heavy
      capabilities = 'cuda'
      detail = 'in 2D with the 3-point stencil on CUDA.'
    []
  []

  [poisson]
    requirement = 'The system shall solve the singular steady periodic Poisson problem with implicit finite differences and return the zero-mean solution, using the torch preconditioned conjugate gradient solver'
    [3pt]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'with the second order 3-point stencil,'
    []
    [5pt]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorComputes/Solve/lap/stencil_width=5 Outputs/file_base=poisson_mms_5pt'
      csvdiff = poisson_mms_5pt.csv
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'with the fourth order 5-point stencil, and'
    []
    [3pt_mps]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorSolver/l_tol=1e-5 Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      # single precision: the zero mean holds to round-off of the field magnitude
      abs_zero = 1e-5
      rel_err = 1e-4
      compute_devices = 'mps'
      detail = 'with the 3-point stencil in single precision on MPS.'
    []
  []

  [poisson_petsc]
    requirement = 'The system shall solve the singular steady periodic Poisson problem with implicit finite differences and return the zero-mean solution, using the PETSc conjugate gradient solver with geometric multigrid'
    [3pt]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      prereq = 'poisson/3pt'
      compute_devices = 'cpu'
      detail = 'with the second order 3-point stencil,'
    []
    [5pt]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC TensorComputes/Solve/lap/stencil_width=5 Outputs/file_base=poisson_mms_5pt'
      csvdiff = poisson_mms_5pt.csv
      prereq = 'poisson/5pt'
      compute_devices = 'cpu'
      detail = 'with the fourth order 5-point stencil, and'
    []
    [3pt_cuda]
      type = CSVDiff
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      compute_devices = 'cuda'
      min_slots = 2 # memory heavy
      capabilities = 'cuda'
      detail = 'with the 3-point stencil on CUDA.'
    []
  []

  [poisson_petsc_uneven_ranks]
    requirement = 'The system shall solve the singular steady periodic Poisson problem with the PETSc multigrid preconditioned solver on ranks that own unequal numbers of cells'
    [3pt]
      type = CSVDiff
      input = poisson_mms.i
      # 32 cells over 3 ranks (10, 11, 11): uneven slabs on every multigrid level
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/file_base=poisson_mms_3pt'
      csvdiff = poisson_mms_3pt.csv
      prereq = 'poisson_petsc/3pt'
      min_parallel = 3
      max_parallel = 3
      compute_devices = 'cpu'
      detail = 'with the 3-point stencil on 3 ranks.'
    []
  []

  [cutback]
    requirement = 'The system shall retry an implicit finite-difference time step with a smaller time step when its linear solve does not converge'
    [torch_pcg]
      type = RunApp
      input = cutback.i
      expect_out = 'did not converge in 30 iterations.*Solve failed, cutting timestep.*did not converge in 30 iterations.*Solve failed, cutting timestep.*Time Step 1, time = 0.002'
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'using the torch preconditioned conjugate gradient solver.'
    []
  []

  [biharmonic]
    requirement = 'The system shall integrate a periodic Fourier mode of u_t = -M kappa Laplacian(Laplacian(u)) with implicit backward Euler finite differences, reproducing the exact discrete amplification factor in every step,'
    [3pt_torch]
      type = CSVDiff
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG Outputs/file_base=biharmonic_mode_3pt'
      csvdiff = biharmonic_mode_3pt.csv
      # the gold is the exact amplification; max_error is the solve error
      abs_zero = 1e-8
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'with the composed 3-point stencil and the torch preconditioned conjugate gradient solver,'
    []
    [5pt_torch]
      type = CSVDiff
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG stencil=5 Outputs/file_base=biharmonic_mode_5pt'
      csvdiff = biharmonic_mode_5pt.csv
      abs_zero = 1e-8
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'with the composed 5-point stencil and the torch preconditioned conjugate gradient solver,'
    []
    [3pt_torch_mps]
      type = CSVDiff
      input = biharmonic_mode.i
      # MPS has no double precision: a single precision reachable tolerance
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorSolver/l_tol=1e-5 Outputs/file_base=biharmonic_mode_3pt'
      csvdiff = biharmonic_mode_3pt.csv
      # max_error is the single precision solve error at l_tol = 1e-5 (1.3e-5 measured)
      abs_zero = 1e-4
      rel_err = 1e-5
      compute_devices = 'mps'
      detail = 'with the composed 3-point stencil and the torch preconditioned conjugate gradient solver in single precision on MPS,'
    []
    [3pt_petsc]
      type = CSVDiff
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/file_base=biharmonic_mode_3pt'
      csvdiff = biharmonic_mode_3pt.csv
      abs_zero = 1e-8
      prereq = 'biharmonic/3pt_torch'
      compute_devices = 'cpu'
      detail = 'with the composed 3-point stencil and the PETSc multigrid solver,'
    []
    [5pt_petsc]
      type = CSVDiff
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC stencil=5 Outputs/file_base=biharmonic_mode_5pt'
      csvdiff = biharmonic_mode_5pt.csv
      abs_zero = 1e-8
      prereq = 'biharmonic/5pt_torch'
      compute_devices = 'cpu'
      detail = 'with the composed 5-point stencil and the PETSc multigrid solver,'
    []
    [3pt_petsc_cuda]
      type = CSVDiff
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/file_base=biharmonic_mode_3pt'
      csvdiff = biharmonic_mode_3pt.csv
      abs_zero = 1e-8
      prereq = 'biharmonic/3pt_torch'
      compute_devices = 'cuda'
      min_slots = 2 # memory heavy
      capabilities = 'cuda'
      detail = 'with the composed 3-point stencil and the PETSc multigrid solver on CUDA,'
    []
    [3d_3pt_torch]
      type = CSVDiff
      input = biharmonic_mode3d.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG Outputs/file_base=biharmonic_mode_3d_3pt'
      csvdiff = biharmonic_mode_3d_3pt.csv
      abs_zero = 1e-8
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 3D with the composed 3-point stencil and the torch preconditioned conjugate gradient solver,'
    []
    [3d_5pt_torch]
      type = CSVDiff
      input = biharmonic_mode3d.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG stencil=5 Outputs/file_base=biharmonic_mode_3d_5pt'
      csvdiff = biharmonic_mode_3d_5pt.csv
      abs_zero = 1e-8
      compute_devices = 'cpu cuda'
      min_slots = 2 # memory heavy
      detail = 'in 3D with the composed 5-point stencil and the torch preconditioned conjugate gradient solver,'
    []
    [3d_3pt_petsc]
      type = CSVDiff
      input = biharmonic_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/file_base=biharmonic_mode_3d_3pt'
      csvdiff = biharmonic_mode_3d_3pt.csv
      abs_zero = 1e-8
      prereq = 'biharmonic/3d_3pt_torch'
      compute_devices = 'cpu'
      detail = 'in 3D with the composed 3-point stencil and the PETSc multigrid solver,'
    []
    [3d_5pt_petsc]
      type = CSVDiff
      input = biharmonic_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC stencil=5 Outputs/file_base=biharmonic_mode_3d_5pt'
      csvdiff = biharmonic_mode_3d_5pt.csv
      abs_zero = 1e-8
      prereq = 'biharmonic/3d_5pt_torch'
      compute_devices = 'cpu'
      detail = 'in 3D with the composed 5-point stencil and the PETSc multigrid solver, and'
    []
    [3d_5pt_petsc_cuda]
      type = CSVDiff
      input = biharmonic_mode3d.i
      cli_args = 'TensorSolver/linear_solver=PETSC stencil=5 Outputs/file_base=biharmonic_mode_3d_5pt'
      csvdiff = biharmonic_mode_3d_5pt.csv
      abs_zero = 1e-8
      prereq = 'biharmonic/3d_5pt_torch'
      compute_devices = 'cuda'
      min_slots = 2 # memory heavy
      capabilities = 'cuda'
      detail = 'in 3D with the composed 5-point stencil and the PETSc multigrid solver on CUDA.'
    []
  []

  [grid_independence]
    requirement = 'The system shall solve the singular steady periodic Poisson problem with the PETSc multigrid preconditioned solver in a number of iterations that does not grow with the grid size'
    [n64]
      type = RunApp
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC n=64 Outputs/csv=false -u_ksp_converged_reason'
      # 9 iterations measured; fail above 12
      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL iterations'
      absent_out = 'iterations ([0-9]{3,}|[2-9][0-9]|1[3-9])\b'
      compute_devices = 'cpu'
      detail = 'on a 64 x 64 grid,'
    []
    [n128]
      type = RunApp
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC n=128 Outputs/csv=false -u_ksp_converged_reason'
      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL iterations'
      absent_out = 'iterations ([0-9]{3,}|[2-9][0-9]|1[3-9])\b'
      compute_devices = 'cpu'
      detail = 'on a 128 x 128 grid, and'
    []
    [n256]
      type = RunApp
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=PETSC n=256 Outputs/csv=false -u_ksp_converged_reason'
      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL iterations'
      absent_out = 'iterations ([0-9]{3,}|[2-9][0-9]|1[3-9])\b'
      compute_devices = 'cpu'
      detail = 'on a 256 x 256 grid.'
    []
  []

  [petsc_options]
    requirement = 'The system shall pass PETSc options to the implicit finite-difference solve under the prefix of the solved field'
    [default]
      type = RunApp
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/csv=false -u_ksp_view'
      expect_out = 'KSP Object: \(u_\).*type: cg.*PC Object: \(u_\).*type: mg'
      compute_devices = 'cpu'
      detail = 'with the conjugate gradient method and geometric multigrid by default,'
    []
    [block]
      type = RunApp
      input = be_mode.i
      cli_args = "TensorSolver/linear_solver=PETSC TensorSolver/petsc_options_iname='-pc_type' "
                 "TensorSolver/petsc_options_value='jacobi' Outputs/csv=false -u_ksp_view"
      expect_out = 'PC Object: \(u_\) [^\n]*\n\s+type: jacobi'
      compute_devices = 'cpu'
      detail = 'from the solver block,'
    []
    [command_line]
      type = RunApp
      input = be_mode.i
      cli_args = "TensorSolver/linear_solver=PETSC TensorSolver/petsc_options_iname='-pc_type' "
                 "TensorSolver/petsc_options_value='jacobi' Outputs/csv=false -u_pc_type none "
                 "-u_ksp_view"
      expect_out = 'PC Object: \(u_\) [^\n]*\n\s+type: none'
      compute_devices = 'cpu'
      detail = 'from the command line, overriding the solver block, and'
    []
    [last_step]
      type = RunApp
      input = be_mode.i
      # the default smoother takes 2 iterations
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/csv=false -u_mg_levels_ksp_max_it 3 -u_ksp_view'
      expect_out = 'Time Step 10,.*KSP Object: \(u_mg_levels_1_\).*maximum iterations=3'
      compute_devices = 'cpu'
      detail = 'for the multigrid levels, still applied in the last time step.'
    []
  []

  [smoother]
    requirement = 'The system shall smooth every multigrid level of the PETSc solve but the coarsest (LU) '
    [chebyshev]
      type = RunApp
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Outputs/csv=false -u_ksp_view'
      expect_out = 'KSP Object: \(u_mg_levels_1_\)[^\n]*\n\s+type: chebyshev.*PC Object: \(u_mg_levels_1_\)[^\n]*\n\s+type: sor.*KSP Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: chebyshev.*PC Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: jacobi'
      compute_devices = 'cpu'
      detail = 'by Chebyshev with SOR on the coarse levels and Jacobi on the fine level by default,'
    []
    [chebyshev_new_dt]
      type = RunApp
      input = biharmonic_mode.i
      # Jacobi on the levels, as on CUDA: Chebyshev bounds of the coarse levels kept from
      # dt = 1e-6 made the preconditioner indefinite at dt = 100
      cli_args = "TensorSolver/linear_solver=PETSC n=64 Outputs/csv=false Executioner/num_steps=2 "
                 "Executioner/TimeStepper/type=FunctionDT "
                 "Executioner/TimeStepper/function='if(t<1e-6,1e-6,100)' -u_mg_levels_pc_type jacobi "
                 "-u_ksp_converged_reason"
      expect_out = 'Time Step 2,.*Linear u_ solve converged due to CONVERGED_RTOL'
      compute_devices = 'cpu'
      detail = 'with the Chebyshev eigenvalue bounds of every level estimated again when the time step changes,'
    []
    [weight]
      type = RunApp
      input = biharmonic_mode.i
      # fine level: 1/dt = 100 and the 13-point stencil of Mkappa = 1e-3 at h = 1/32
      # give rho = 1 + 44 Mkappa / h^4 / (100 + 20 Mkappa / h^4), omega = 0.418031
      cli_args = 'TensorSolver/linear_solver=PETSC TensorSolver/smoother=DAMPED_JACOBI Outputs/csv=false -u_ksp_view'
      expect_out = 'KSP Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: richardson\n\s+damping factor=0.418031'
      compute_devices = 'cpu'
      detail = 'by damped Jacobi with the weight 4/(3 rho), rho the Gershgorin bound of the level operator, when requested,'
    []
    [user_weight]
      type = RunApp
      input = biharmonic_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC TensorSolver/smoother=DAMPED_JACOBI Outputs/csv=false -u_mg_levels_ksp_richardson_scale 0.3 -u_ksp_view'
      expect_out = 'Time Step 10,.*KSP Object: \(u_mg_levels_2_\)[^\n]*\n\s+type: richardson\n\s+damping factor=0.3\n'
      compute_devices = 'cpu'
      detail = 'with a damped Jacobi weight set on the command line instead, still applied in the last time step.'
    []
  []

  [divergence_test]
    requirement = 'The system shall not stop a converging PETSc solve of a large implicit time step on the divergence test'
    [biharmonic_large_dt]
      type = RunApp
      input = biharmonic_mode.i
      # warm started from u_old, ||r0|| / ||b|| = dt Mkappa lambda^2 ~ 6e3 at dt = 1000; the
      # first CG residual exceeded the default divtol of 1e4 times ||b||; it converges in 22
      cli_args = 'TensorSolver/linear_solver=PETSC TensorSolver/smoother=DAMPED_JACOBI n=128 dt=1000 Executioner/num_steps=1 Outputs/csv=false -u_ksp_converged_reason'
      expect_out = 'Linear u_ solve converged due to CONVERGED_RTOL'
      compute_devices = 'cpu'
    []
  []

  [errors]
    requirement = 'The system shall report an error if an implicit finite-difference solve is set up '
    [not_spd]
      type = RunException
      input = poisson_mms.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorComputes/Solve/lap/factor=0.5'
      expect_err = 'is not symmetric positive \(semi\)definite'
      detail = 'with an operator that is not symmetric positive (semi)definite,'
    []
    [nonzero_mean_source]
      type = RunException
      input = poisson_mms.i
      cli_args = "TensorSolver/linear_solver=TORCH_PCG TensorComputes/Initialize/f_ic/expression='1 "
                 "+ x'"
      expect_err = 'the right-hand side must have zero mean'
      detail = 'for a singular operator with a right-hand side that has a nonzero mean,'
    []
    [petsc_single_precision]
      type = RunException
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC Domain/floating_precision=SINGLE'
      expect_err = 'The PETSC linear solver requires double precision'
      compute_devices = 'cpu'
      detail = 'with the PETSc linear solver in single precision,'
    []
    [petsc_mps]
      type = RunException
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=PETSC'
      expect_err = 'The PETSC linear solver does not run on MPS'
      compute_devices = 'mps'
      detail = 'with the PETSc linear solver on MPS,'
    []
    [petsc_options_with_torch_pcg]
      type = RunException
      input = be_mode.i
      cli_args = "TensorSolver/linear_solver=TORCH_PCG TensorSolver/petsc_options_iname='-pc_type' "
                 "TensorSolver/petsc_options_value='jacobi'"
      expect_err = 'This parameter is not used by linear_solver = TORCH_PCG'
      detail = 'with PETSc options for the torch linear solver,'
    []
    [smoother_with_torch_pcg]
      type = RunException
      input = be_mode.i
      cli_args = 'TensorSolver/linear_solver=TORCH_PCG TensorSolver/smoother=DAMPED_JACOBI'
      expect_err = 'smoother.*This parameter is not used by linear_solver = TORCH_PCG'
      detail = 'with a multigrid smoother for the torch linear solver,'
    []
    [failed_solve_without_cutback]
      type = RunException
      input = cutback.i
      # two substeps of dt / 2 = 0.004 need about 34 iterations
      cli_args = 'TensorSolver/substeps=2'
      expect_err = 'did not converge in 30 iterations.*Use the TensorSolveIterationAdaptiveDT time stepper \(with substeps = 1\)'
      detail = 'with a linear solve that does not converge when the time step cannot be retried,'
    []
    [fields_differing_in_case]
      type = RunException
      input = be_mode.i
      cli_args = "TensorSolver/linear_solver=TORCH_PCG TensorSolver/buffer='u U' "
                 "TensorSolver/operators='dudt lap; dudt lap'"
