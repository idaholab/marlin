[Tests]
  [laplacian]
    issues = '#122'
    design = FiniteDifferenceLaplacian.md
    requirement = 'The system shall be able to compute a Laplacian in real space '
    [2d_3x3]
      type = CSVDiff
      input = laplacian.i
      csvdiff = laplacian_out.csv
      compute_devices = 'cpu cuda mps xpu'
      detail = 'using a 3x3 stencil.'
    []
    [2d_5x5]
      type = CSVDiff
      input = laplacian.i
      csvdiff = laplacian_5pt_out.csv
      cli_args = 'TensorComputes/Solve/lap_compute/stencil_width=5 Outputs/file_base=laplacian_5pt_out'
      compute_devices = 'cpu cuda mps xpu'
      detail = 'using a 5x5 stencil.'
    []
    [3d_3x3]
      type = CSVDiff
      input = laplacian3d.i
      csvdiff = laplacian3d_out.csv
      compute_devices = 'cpu cuda mps xpu'
      detail = 'using a 3x3x3 stencil.'
    []
    [3d_5x5]
      type = CSVDiff
      input = laplacian3d.i
      csvdiff = laplacian3d_5pt_out.csv
      cli_args = 'TensorComputes/Solve/lap_compute/stencil_width=5 Outputs/file_base=laplacian3d_5pt_out'
      compute_devices = 'cpu cuda mps xpu'
      detail = 'using a 3x3x3 stencil.'
    []
  []

  [diffusion]
    issues = '#122'
    design = FiniteDifferenceLaplacian.md
    requirement = 'The system shall be able to solve a transient diffusion problem in real space '
    [2d_3x3]
      type = CSVDiff
      input = diffusion.i
      csvdiff = diffusion_out.csv
      compute_devices = 'cpu cuda mps xpu'
      min_slots = 2 # memory heavy
      detail = 'using a 3x3 stencil.'
    []
  []

  [dirichlet_bc]
    issues = '#122'
    design = TensorDirichletBC.md
    requirement = 'The system shall be able to apply a Dirichlet boundary condition in real space '
    [laplacian_check]
      type = CSVDiff
      input = dirichlet_laplacian_check.i
      csvdiff = dirichlet_laplacian_check_out.csv
      compute_devices = 'cpu cuda mps xpu'
      detail = 'and reproduce the discrete Laplacian expected from an initial condition that is consistent with the boundary values up to a small required perturbation.'
    []
    [relaxation]
      type = CSVDiff
      input = dirichlet_linear.i
      csvdiff = dirichlet_linear_out.csv
      compute_devices = 'cpu cuda mps xpu'
      detail = 'and relax an initial condition that does not satisfy the boundary values toward the exact linear steady-state profile they imply.'
    []
    [2d_corners]
      type = CSVDiff
      input = dirichlet_2d_corners.i
      csvdiff = dirichlet_2d_corners_out.csv
      compute_devices = 'cpu cuda mps xpu'
      detail = 'on a domain that is non-periodic on both axes, exercising the ghost-fill at all four domain corners.'
    []
  []

  [analytic_verification]
    issues = '#122'
    design = TensorDirichletBC.md
    requirement = 'The system shall reproduce an analytic diffusion solution from Crank, "The Mathematics of Diffusion" (2nd ed.) '
    [semi_infinite]
      type = CSVDiff
      input = semi_infinite_diffusion.i
      csvdiff = semi_infinite_diffusion_out.csv
      compute_devices = 'cpu cuda mps xpu'
      min_slots = 2 # memory heavy
      detail = 'for a semi-infinite medium with a constant surface concentration (Sec. 3.3(i), eq. 3.13, special case of zero initial concentration).'
    []
    [thin_slab]
      type = CSVDiff
      input = thin_slab_diffusion.i
      csvdiff = thin_slab_diffusion_out.csv
      compute_devices = 'cpu cuda mps xpu'
      min_slots = 2 # memory heavy
      detail = 'for an instantaneous planar source confined to a thin slab, diffusing into an infinite medium (Sec. 2.5, eq. 2.15).'
    []
  []

  [neumann_bc]
    issues = '#122'
    design = TensorNeumannBC.md
    requirement = 'The system shall be able to apply a Neumann boundary condition in real space '
    [conservation]
      type = CSVDiff
      input = neumann_conservation.i
      csvdiff = neumann_conservation_out.csv
      compute_devices = 'cpu cuda mps xpu'
      detail = 'and conserve the total integral of a field under zero-flux boundary conditions on all non-periodic faces, from a non-uniform initial condition.'
    []
    [conservation_5pt]
      type = CSVDiff
      input = neumann_conservation.i
      csvdiff = neumann_conservation_5pt_out.csv
      # the 5-point stencil's explicit limit is 3/4 of the 3-point one, below the 1e-3 substep
      cli_args = 'TensorComputes/Solve/dt/stencil_width=5 TensorSolver/substeps=2000 Outputs/file_base=neumann_conservation_5pt_out'
      compute_devices = 'cpu cuda mps xpu'
      detail = 'and conserve it with the 5-point Laplacian, which reads two ghost layers.'
    []
    [linear]
      type = CSVDiff
      input = neumann_linear.i
      csvdiff = neumann_linear_out.csv
      compute_devices = 'cpu cuda mps xpu'
      min_slots = 2 # memory heavy
      # max_error decays to the double-precision noise floor, where summation-order
      # differences between serial and parallel runs dominate the relative diff
      override_columns = 'max_error'
      override_rel_err = '5.5e-6'
      override_abs_zero = '1e-8'
      detail = 'and relax an initial condition toward the exact linear steady-state profile implied by a Dirichlet condition on one face and a nonzero-flux Neumann condition on the other.'
    []
  []

  [robin_bc]
    issues = '#122'
    design = TensorRobinBC.md
    requirement = 'The system shall be able to apply a general Robin boundary condition in real space and relax an initial condition toward the exact linear steady-state profile it implies, cross-validated against '
    [steady_state]
      type = CSVDiff
      input = robin_steady_state.i
      csvdiff = robin_steady_state_out.csv
      compute_devices = 'cpu cuda mps xpu'
      min_slots = 2 # memory heavy
      detail = 'the elliptic Robin benchmark from the OpenGeoSys documentation (opengeosys.org/6.5.7/docs/benchmarks/elliptic/elliptic-robin).'
    []
  []
  [bc_errors]
    issues = '#122'
    design = 'TensorRobinBC.md'
    requirement = 'The system shall report an error for a real-space boundary condition '
    [periodic_face]
      type = RunException
      input = neumann_linear.i
      cli_args = 'TensorComputes/BCs/right/boundary=top'
      expect_err = 'This face lies on a periodic direction'
      detail = 'on a face of a periodic direction,'
    []
    [missing_face]
      type = RunException
      input = neumann_linear.i
      cli_args = 'Domain/dim=3 Domain/nz=2 TensorComputes/BCs/right/boundary=back'
      expect_err = "has no boundary condition on the right face"
      detail = 'when a non-periodic face of a buffer read with ghost layers has none,'
    []
    [nonexistent_face]
      type = RunException
      input = neumann_linear.i
      cli_args = 'TensorComputes/BCs/right/boundary=back'
      expect_err = 'This face does not exist in a 2D domain'
      detail = 'on a face beyond the domain dimension,'
    []
    [duplicate]
      type = RunException
      input = neumann_linear.i
      cli_args = 'TensorComputes/BCs/right/boundary=left'
      expect_err = "both act on buffer 'u' on the same face"
      detail = 'when two boundary conditions act on the same buffer and face,'
    []
    [unused]
      type = RunException
      input = neumann_linear.i
      cli_args = 'TensorComputes/BCs/extra/type=TensorDirichletBC TensorComputes/BCs/extra/variable=u_exact TensorComputes/BCs/extra/boundary=left'
      expect_err = "is not read with ghost layers by any compute"
      detail = 'on a buffer that is not read with ghost layers,'
    []
    [not_a_bc]
      type = RunException
      input = neumann_linear.i
      cli_args = 'TensorComputes/BCs/extra/type=ConstantTensor TensorComputes/BCs/extra/buffer=extra'
      expect_err = "in \[TensorComputes/BCs\] is not a boundary condition"
      detail = 'when the object is not a boundary condition,'
    []
    [robin_zero_denominator]
      type = RunException
      input = robin_steady_state.i
      cli_args = 'TensorComputes/BCs/right/a=-40' # a/2 + b/dx = -20 + 1/0.05
      expect_err = 'a/2 \+ b/dx must be nonzero'
      detail = 'and when the Robin ghost-value denominator a/2 + b/dx is zero,'
    []
    [robin_zero_second_layer_denominator]
      type = RunException
      input = robin_steady_state.i
      # a/2 + b/(3dx) = -20/3 + 1/0.15
      cli_args = 'TensorComputes/BCs/right/a=-13.333333333333334 TensorComputes/Solve/dt/stencil_width=5'
      expect_err = 'requires a/2 \+ b/\(3\*dx\) to be nonzero'
      detail = 'or, with two ghost layers, when a/2 + b/(3dx) is zero.'
    []
  []

  [integral_change]
    issues = '#122'
    design = TensorIntegralChangePostprocessor.md
    requirement = 'The system shall compute the integral of the absolute change of a buffer over the last solver substep from the owned cells only, independent of the ghost layers and the number of ranks, '
    [double]
      type = CSVDiff
      input = diffusion.i
      cli_args = 'Postprocessors/change/type=TensorIntegralChangePostprocessor Postprocessors/change/buffer=u Outputs/file_base=diffusion_change_out'
      csvdiff = diffusion_change_out.csv
      compute_devices = 'cpu cuda xpu'
      detail = 'in double precision,'
    []
    [double_2_ranks]
      type = CSVDiff
      input = diffusion.i
      cli_args = 'Postprocessors/change/type=TensorIntegralChangePostprocessor Postprocessors/change/buffer=u Outputs/file_base=diffusion_change_out'
      csvdiff = diffusion_change_out.csv
      prereq = 'integral_change/double'
      min_parallel = 2
      max_parallel = 2
      compute_devices = 'cpu'
      detail = 'in double precision on 2 ranks, and'
    []
    [mps]
      type = CSVDiff
      input = diffusion.i
      cli_args = 'Postprocessors/change/type=TensorIntegralChangePostprocessor Postprocessors/change/buffer=u Outputs/file_base=diffusion_change_out'
      csvdiff = diffusion_change_out.csv
      # single precision: late in the run the change (~4e-9) is at the float32 rounding
      # of u, so it is compared only above 1e-7 (measured: U and max_u within 8.4e-6,
      # change within 2.6e-4 above 1e-7)
      rel_err = 1e-5
      override_columns = 'change'
      override_rel_err = '1e-3'
      override_abs_zero = '1e-7'
      compute_devices = 'mps'
      detail = 'in single precision on MPS.'
    []
  []
[]
