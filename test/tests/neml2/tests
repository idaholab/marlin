[Tests]
  [scalar]
    type = CSVDiff
    input = scalar.i
    csvdiff = scalar_out.csv
    issues = '#35'
    design = NEML2TensorCompute.md
    capabilities = neml2
    requirement = 'The system shall be able to use NEML2 models as tensor computes'
    compute_devices = 'cpu cuda mps xpu'
    max_parallel = 1
    min_slots = 2 # 362 MB per slot observed during https://civet.inl.gov/job/4323123/ during step Test cuda debug. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
  [scalar_single]
    type = CSVDiff
    input = scalar.i
    cli_args = 'Domain/floating_precision=SINGLE'
    csvdiff = scalar_out.csv
    prereq = scalar
    issues = '#35'
    design = NEML2TensorCompute.md
    capabilities = neml2
    requirement = 'The system shall evaluate NEML2 models with single precision tensor buffers.'
    compute_devices = 'mps'
    max_parallel = 1
    min_slots = 2
  []
  [symmetric]
    type = CSVDiff
    input = symmetric.i
    csvdiff = symmetric_out.csv
    issues = '#35'
    design = NEML2TensorCompute.md
    capabilities = neml2
    requirement = 'The system shall write NEML2 symmetric tensor outputs to explicitly declared tensor buffers.'
    compute_devices = 'cpu cuda mps xpu'
    max_parallel = 1
    min_slots = 2
  []
  [deprecated_buffer_type]
    type = RunApp
    input = symmetric.i
    cli_args = 'TensorBuffers/symmetric/type=SR2Tensor Outputs/csv=false'
    expect_out = 'Replace SR2Tensor with PlainTensorBuffer'
    no_error_deprecated = true
    prereq = symmetric
    issues = '#35'
    design = PlainTensorBuffer.md
    capabilities = neml2
    requirement = 'The system shall accept the deprecated SR2Tensor buffer type as an alias of PlainTensorBuffer.'
    compute_devices = 'cpu cuda mps xpu'
    max_parallel = 1
    min_slots = 2
  []
[]
